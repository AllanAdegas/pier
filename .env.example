# Settings read by compose.yaml. Copy to .env and adjust; .env is not versioned.

# Where Pier keeps its database, its key and the files of the local server.
# Mounted at this same path inside the container, so it must be an absolute
# path of the host. On Docker Desktop (macOS/Windows) it has to be inside a
# folder shared with Docker, e.g. /Users/you/pier-data.
PIER_DATA_DIR=/data/pier

# Address and port of the panel on the host. Keep 127.0.0.1 until the first
# administrator exists: whoever opens a fresh panel first creates the account.
PIER_BIND=127.0.0.1
PIER_PORT=8700

# Passphrase that derives the key encrypting stored secrets (16+ characters).
# Empty: Pier generates one in <PIER_DATA_DIR>/secret.key on the first boot.
# Losing it makes every stored secret unreadable.
PIER_SECRET_KEY=

# Deploys running at the same time (of different applications).
PIER_DEPLOY_CONCURRENCY=2

# Longest a single deploy may take (clone, build, release) before it is
# stopped, e.g. 30m or 2h.
PIER_DEPLOY_TIMEOUT=1h

# Proxies allowed to tell Pier the client address and scheme through
# X-Forwarded-For/-Proto (CIDRs or addresses, comma-separated). Empty means
# loopback and private networks, which covers the proxy Pier manages. Set
# the exact address of your proxy to be stricter, or "none".
PIER_TRUSTED_PROXIES=

# Time zone of scheduled tasks and backups.
TZ=America/Sao_Paulo

# Only for compose.proxy.yaml: the domain the panel answers on.
# PIER_DOMAIN=pier.example.com

# Each server runs one build at a time. Requires Docker Buildx; the dedicated
# BuildKit container enforces CPU quota and memory (plain docker build ignores
# these limits with BuildKit). CPUs may be fractional; memory uses Docker units.
PIER_BUILD_CPUS=1
PIER_BUILD_MEMORY=2g
# Minimum free GiB on Docker's data-root (0 disables the check).
PIER_BUILD_MIN_FREE_GB=2
# Build cache budget in GiB. Pruned after each successful build.
PIER_BUILD_CACHE_GB=10

# Force Secure cookies even when a TLS-terminating proxy omits its scheme.
# Enable only after HTTPS is configured. HTTPS PublicURL also enables HSTS.
PIER_COOKIE_SECURE=0
