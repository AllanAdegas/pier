# Settings read by compose.yaml. Copy to .env and adjust; .env is not versioned.

# Where Pier keeps its database, its key and the files of the local server.
# Mounted at this same path inside the container, so it must be an absolute
# path of the host. On Docker Desktop (macOS/Windows) it has to be inside a
# folder shared with Docker, e.g. /Users/you/pier-data.
PIER_DATA_DIR=/data/pier

# Address and port of the panel on the host. Keep 127.0.0.1 until the first
# administrator exists: whoever opens a fresh panel first creates the account.
PIER_BIND=127.0.0.1
PIER_PORT=8700

# Passphrase that derives the key encrypting stored secrets (16+ characters).
# Empty: Pier generates one in <PIER_DATA_DIR>/secret.key on the first boot.
# Losing it makes every stored secret unreadable.
PIER_SECRET_KEY=

# Deploys running at the same time (of different applications).
PIER_DEPLOY_CONCURRENCY=2

# Time zone of scheduled tasks and backups.
TZ=America/Sao_Paulo

# Only for compose.proxy.yaml: the domain the panel answers on.
# PIER_DOMAIN=pier.example.com
