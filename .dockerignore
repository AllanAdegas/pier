# Everything the image build does not read. The interface and the binary are
# compiled inside the image, so local build output stays out.
.git
.gitignore
.dockerignore
.env
.env.*
*.pem
*.key
id_rsa*
id_ed25519*
Dockerfile
compose*.yaml
Makefile
README.md

bin/
data/
.data/
.data-dev/

web/node_modules/
web/dist/
internal/webui/dist/*
!internal/webui/dist/.gitkeep

**/.DS_Store
install.sh

# The launch site has its own image (site/Dockerfile).
site/
/pier
